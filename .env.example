# Copy this file to .env and adjust if your local setup differs.
# These defaults match docker-compose.yml's postgres service exactly,
# so `docker compose up -d` + the defaults below work with zero config.

DATABASE_URL=postgresql+psycopg://forgesentinel:forgesentinel@localhost:5432/forgesentinel

# Milestone 11: Grafana admin password (docker-compose.yml's grafana
# service). Change this before ever exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=forgesentinel

# Milestone 14: AI Incident Analyst (tasks/incident_analysis.py). Get
# a key from https://console.anthropic.com - never commit a real one.
# Without this set, POST /api/incidents/analyze/{alert_id} will accept
# the request but the Celery task will fail with an authentication
# error when it actually calls Claude.
ANTHROPIC_API_KEY=
